# Base URL of the NestJS API. The server's CORS_ORIGINS must list this app's
# origin (http://localhost:5174 in development) or every request is blocked.
VITE_API_BASE_URL=http://localhost:3000

# Must match GOOGLE_CLIENT_ID on the server — it is used as the `audience` when
# verifying the ID token. This panel signs in with Google only, so without a
# value there is no way to log in.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
